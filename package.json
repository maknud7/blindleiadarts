{
  "name": "blindleia-darts",
  "private": true,
  "type": "module",
  "scripts": {
    "v2:build": "vite build --config apps/platform-v2/vite.config.mjs",
    "v2:typecheck": "tsc -p apps/platform-v2/tsconfig.json --noEmit",
    "backend-v2:build": "tsc -p apps/backend-v2/tsconfig.json",
    "backend-v2:typecheck": "tsc -p apps/backend-v2/tsconfig.json --noEmit",
    "backend-v2:test": "npm run backend-v2:build && node --test apps/backend-v2/test/*.test.mjs",
    "backend-v2:start": "npm run backend-v2:build && node apps/backend-v2/dist/server.js",
    "backend-v2:verify-host": "node apps/backend-v2/scripts/verify-host-readiness.mjs"
  },
  "dependencies": {
    "bcryptjs": "3.0.2",
    "mysql2": "3.24.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
